{
  "definition": {
    "$schema": "https://schema.management.azure.com/schemas/2016-06-01/Microsoft.Logic.json",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "auroraApiKey": {
        "type": "securestring",
        "defaultValue": ""
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "tel": { "type": "string" }
            },
            "required": ["tel"]
          }
        }
      }
    },
    "actions": {
      "Session_Login": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "https://a1.auth-db.com/api.php",
          "queries": {
            "method": "session.login",
            "api_key": "@parameters('auroraApiKey')",
            "format": "json"
          }
        },
        "runAfter": {}
      },
      "Check_Session_Login_Success": {
        "type": "If",
        "expression": {
          "and": [
            { "equals": ["@body('Session_Login')?['@attributes']?['success']", "1"] }
          ]
        },
        "actions": {
          "Auth_Check": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://a1.auth-db.com/api.php",
              "queries": {
                "method": "auth.check",
                "session_id": "@body('Session_Login')?['session_id']",
                "tel": "@triggerBody()?['tel']",
                "format": "json"
              }
            },
            "runAfter": {}
          },
          "Check_Auth_Check_Success": {
            "type": "If",
            "expression": {
              "and": [
                { "equals": ["@body('Auth_Check')?['@attributes']?['success']", "1"] }
              ]
            },
            "actions": {
              "Check_Already_Verified": {
                "type": "If",
                "expression": {
                  "and": [
                    { "equals": ["@body('Auth_Check')?['status']", "2"] }
                  ]
                },
                "actions": {
                  "Compose_First_AuthId": {
                    "type": "Compose",
                    "inputs": "@coalesce(body('Auth_Check')?['auth_id'], body('Auth_Check')?['id'])",
                    "runAfter": {}
                  },
                  "Auth_Delete": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "https://a1.auth-db.com/api.php",
                      "queries": {
                        "method": "auth.delete",
                        "session_id": "@body('Session_Login')?['session_id']",
                        "auth_id": "@outputs('Compose_First_AuthId')",
                        "format": "json"
                      }
                    },
                    "runAfter": { "Compose_First_AuthId": ["Succeeded"] }
                  },
                  "Auth_Check_Retry": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "https://a1.auth-db.com/api.php",
                      "queries": {
                        "method": "auth.check",
                        "session_id": "@body('Session_Login')?['session_id']",
                        "tel": "@triggerBody()?['tel']",
                        "format": "json"
                      }
                    },
                    "runAfter": { "Auth_Delete": ["Succeeded"] }
                  },
                  "Check_Retry_Success": {
                    "type": "If",
                    "expression": {
                      "and": [
                        { "equals": ["@body('Auth_Check_Retry')?['@attributes']?['success']", "1"] }
                      ]
                    },
                    "actions": {
                      "Compose_AuthId_Retry": {
                        "type": "Compose",
                        "inputs": "@coalesce(body('Auth_Check_Retry')?['auth_id'], body('Auth_Check_Retry')?['id'])",
                        "runAfter": {}
                      },
                      "Compose_Pin_Retry": {
                        "type": "Compose",
                        "inputs": "@body('Auth_Check_Retry')?['pin']",
                        "runAfter": { "Compose_AuthId_Retry": ["Succeeded"] }
                      },
                      "Sms_Send_Retry": {
                        "type": "Http",
                        "inputs": {
                          "method": "GET",
                          "uri": "https://a1.auth-db.com/api.php",
                          "queries": {
                            "method": "sms.send",
                            "session_id": "@body('Session_Login')?['session_id']",
                            "auth_id": "@outputs('Compose_AuthId_Retry')",
                            "sms_title": "ABEE",
                            "sms_text": "@concat('ABEEペットサロンの認証コードは ', outputs('Compose_Pin_Retry'), ' です。')",
                            "format": "json"
                          }
                        },
                        "runAfter": { "Compose_Pin_Retry": ["Succeeded"] }
                      },
                      "Check_Sms_Send_Retry_Success": {
                        "type": "If",
                        "expression": {
                          "and": [
                            { "equals": ["@body('Sms_Send_Retry')?['@attributes']?['success']", "1"] }
                          ]
                        },
                        "actions": {
                          "Response_Success_Retry": {
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                              "statusCode": 200,
                              "headers": { "Content-Type": "application/json" },
                              "body": {
                                "pinId": "@outputs('Compose_AuthId_Retry')"
                              }
                            },
                            "runAfter": {}
                          }
                        },
                        "else": {
                          "actions": {
                            "Response_Sms_Send_Retry_Failed": {
                              "type": "Response",
                              "kind": "Http",
                              "inputs": {
                                "statusCode": 502,
                                "headers": { "Content-Type": "application/json" },
                                "body": {
                                  "pinId": null,
                                  "error": "sms_send_failed",
                                  "detail": "@body('Sms_Send_Retry')"
                                }
                              },
                              "runAfter": {}
                            }
                          }
                        },
                        "runAfter": { "Sms_Send_Retry": ["Succeeded"] }
                      }
                    },
                    "else": {
                      "actions": {
                        "Response_Auth_Check_Retry_Failed": {
                          "type": "Response",
                          "kind": "Http",
                          "inputs": {
                            "statusCode": 502,
                            "headers": { "Content-Type": "application/json" },
                            "body": {
                              "pinId": null,
                              "error": "auth_check_retry_failed",
                              "detail": "@body('Auth_Check_Retry')"
                            }
                          },
                          "runAfter": {}
                        }
                      }
                    },
                    "runAfter": { "Auth_Check_Retry": ["Succeeded"] }
                  }
                },
                "else": {
                  "actions": {
                    "Compose_AuthId_Direct": {
                      "type": "Compose",
                      "inputs": "@coalesce(body('Auth_Check')?['auth_id'], body('Auth_Check')?['id'])",
                      "runAfter": {}
                    },
                    "Compose_Pin_Direct": {
                      "type": "Compose",
                      "inputs": "@body('Auth_Check')?['pin']",
                      "runAfter": { "Compose_AuthId_Direct": ["Succeeded"] }
                    },
                    "Sms_Send_Direct": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "https://a1.auth-db.com/api.php",
                        "queries": {
                          "method": "sms.send",
                          "session_id": "@body('Session_Login')?['session_id']",
                          "auth_id": "@outputs('Compose_AuthId_Direct')",
                          "sms_title": "ABEE",
                          "sms_text": "@concat('ABEEペットサロンの認証コードは ', outputs('Compose_Pin_Direct'), ' です。')",
                          "format": "json"
                        }
                      },
                      "runAfter": { "Compose_Pin_Direct": ["Succeeded"] }
                    },
                    "Check_Sms_Send_Direct_Success": {
                      "type": "If",
                      "expression": {
                        "and": [
                          { "equals": ["@body('Sms_Send_Direct')?['@attributes']?['success']", "1"] }
                        ]
                      },
                      "actions": {
                        "Response_Success_Direct": {
                          "type": "Response",
                          "kind": "Http",
                          "inputs": {
                            "statusCode": 200,
                            "headers": { "Content-Type": "application/json" },
                            "body": {
                              "pinId": "@outputs('Compose_AuthId_Direct')"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Response_Sms_Send_Direct_Failed": {
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                              "statusCode": 502,
                              "headers": { "Content-Type": "application/json" },
                              "body": {
                                "pinId": null,
                                "error": "sms_send_failed",
                                "detail": "@body('Sms_Send_Direct')"
                              }
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": { "Sms_Send_Direct": ["Succeeded"] }
                    }
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Response_Auth_Check_Failed": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 502,
                    "headers": { "Content-Type": "application/json" },
                    "body": {
                      "pinId": null,
                      "error": "auth_check_failed",
                      "detail": "@body('Auth_Check')"
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": { "Auth_Check": ["Succeeded"] }
          }
        },
        "else": {
          "actions": {
            "Response_Session_Login_Failed": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 502,
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "pinId": null,
                  "error": "session_login_failed",
                  "detail": "@body('Session_Login')"
                }
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": { "Session_Login": ["Succeeded"] }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "auroraApiKey": {
      "value": ""
    }
  }
}
